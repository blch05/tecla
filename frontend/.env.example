# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Sin estas variables la app funciona igual,
# pero guarda el progreso solo en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
